rules_version = '2';

// Firebase Console → Firestore → Rules бөліміне осы ережелерді қойыңыз.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return signedIn() && userDoc().role == 'teacher';
    }

    function isHomeroom() {
      return signedIn() && request.auth.token.email == 'nurmankyzy83@mail.ru';
    }

    // Профильдер
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if request.auth.uid == uid;
    }

    // ⚠️ Сабақ кестесі Firestore-да сақталмайды —
    // ол `lib/schedule-data.ts` файлында код арқылы қойылған.

    // Сынып хабарламаларын кез келген мұғалім жариялайды.
    // Өшіру/өңдеу: мұғалімдер КЕЗ КЕЛГЕН хабарламаны,
    // қалғандары тек өзі жариялағанын өзгерте алады.
    match /announcements/{id} {
      allow read: if true;
      allow create: if isTeacher();
      allow update, delete: if isHomeroom()
        || isTeacher()
        || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    // Тәрбие сағатының қосымша тақырыптарын тек сынып жетекшісі басқарады.
    match /classHourTopics/{id} {
      allow read: if true;
      allow create: if isHomeroom()
        && request.resource.data.keys().hasOnly([
          'month', 'week', 'direction', 'title', 'about', 'points', 'questions',
          'authorId', 'authorName', 'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.month in [
          'september', 'october', 'november', 'december',
          'january', 'february', 'march', 'april',
          'may'
        ]
        && request.resource.data.week is int
        && request.resource.data.week >= 1
        && request.resource.data.week <= 4
        && request.resource.data.direction is string
        && request.resource.data.direction.size() > 0
        && request.resource.data.direction.size() <= 200
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.about is string
        && request.resource.data.about.size() <= 3000
        && request.resource.data.points is list
        && request.resource.data.points.size() <= 20
        && request.resource.data.questions is list
        && request.resource.data.questions.size() <= 20
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 200
        && request.resource.data.createdAt is int;
      allow update, delete: if isHomeroom();
    }

    // Үй тапсырмасы
    match /homework/{id} {
      allow read: if true;
      allow write: if isTeacher();

      match /submissions/{studentId} {
        allow read: if signedIn();
        allow create, update: if request.auth.uid == studentId || isTeacher();
        allow delete: if isTeacher();
      }
    }

    // Жетістіктер
    match /achievements/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // Байланыс және ата-ана чаттары. Әр қолданушы өз хабарламасын өзгертіп/өшіре алады.
    match /messages/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.senderId == request.auth.uid || isTeacher())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt'])
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 4000
        && request.resource.data.editedAt is int;
      allow delete: if signedIn()
        && (resource.data.senderId == request.auth.uid || isTeacher());
    }

    // Бұрынғы бөлек ата-ана чаты коллекциясына да сол құқықтар қолданылады.
    match /parentMessages/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.senderId == request.auth.uid || isTeacher())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt'])
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 4000
        && request.resource.data.editedAt is int;
      allow delete: if signedIn()
        && (resource.data.senderId == request.auth.uid || isTeacher());
    }

    // Ата-ана кездесулері
    match /consultations/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.parentId == request.auth.uid;
      allow update: if isTeacher() || resource.data.parentId == request.auth.uid;
    }
  }
}
