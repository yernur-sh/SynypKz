# ЖИ-көмекші үшін провайдер кілті (біреуін ғана қойсаңыз жеткілікті).
# Кілт тек серверде оқылады, браузерге жіберілмейді.

# 1) OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# 2) OpenRouter (көп модельге қолжетімділік)
# OPENROUTER_API_KEY=sk-or-...

# 3) Groq (тегін әрі жылдам)
# GROQ_API_KEY=gsk_..

# 4) Google Gemini
# GEMINI_API_KEY=AIza...

# Қалаған модель (міндетті емес)
# AI_MODEL=gpt-4o-mini
